# Shell scripts must check out with LF - core.autocrlf=true would otherwise convert them to
# CRLF, which can break the shebang line and is why launch-triage.sh is pinned here explicitly.
*.sh text eol=lf

# The blessed baseline is compared byte for byte against text this application builds in memory, which
# joins its lines with LF.  Checked out as CRLF it failed at line 1 with two lines that look identical
# (found by the battery, 2026-09-03).  The test strips carriage returns as well; this stops a fresh
# clone needing it.
test/baseline/** text eol=lf

# The tracker's text dump (docs/manual-tests/dump/) is written by triagedb.py with LF and compared byte for byte with
# what the store renders, and it keeps every line of an entry as written, trailing spaces (markdown's hard break)
# included - which git's whitespace check would otherwise flag on every diff.
docs/manual-tests/dump/** text eol=lf -whitespace
